PORT=8895
# order of decision strategies; the first that can serve answers
DECIDE_STRATEGIES=judge,logprob,json
# typed-decision endpoint (JEV-style or bundled judge_server.py); judge is skipped when empty
DECIDE_JUDGE_URL=
# chat LLM for logprob / json (defaults to LLM_PROXY_URL / LLM_PROXY_API_KEY / LLM_MODEL)
DECIDE_LLM_BASE_URL=
DECIDE_LLM_API_KEY=
DECIDE_LLM_MODEL=
DECIDE_PERMUTE=0
ROUTER_THRESHOLD=0.55
ROUTER_DEFAULT_TARGET=deepagents
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=

# optional: narrow many contexts by meaning (any OpenAI-style /embeddings endpoint)
ROUTER_EMBED_URL=
ROUTER_EMBED_MODEL=BAAI/bge-m3
ROUTER_EMBED_KEY=
# candidate narrowing
ROUTER_TOP_K=6
ROUTER_KEEP_RECENT=2
ROUTER_DORMANT_DAYS=30
ROUTER_SCAN=200
ROUTER_EVIDENCE_SIM=0.5
