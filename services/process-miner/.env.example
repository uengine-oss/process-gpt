# 로컬 supabase(docker) 기준 기본값
DB_HOST=127.0.0.1
DB_PORT=54322
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-super-secret-and-long-postgres-password
# 또는 통째로:
# MINER_DB_URL=postgresql://postgres:pw@127.0.0.1:54322/postgres

# 요청자 JWT 검증(agent SDK tenant_auth). 로컬 supabase 기준
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-anon-key
# HS256 토큰을 쓰는 배포라면 로컬 검증용으로
# SUPABASE_JWT_SECRET=...
# 로컬 확인용으로만 인증을 끈다(그래도 tenant_id 는 필수)
# MINER_AUTH=off
# 직접 호출을 허용할 출처(쉼표 구분). 비우면 CORS 를 열지 않는다
# MINER_CORS_ORIGINS=http://localhost:5173
PORT=8015
